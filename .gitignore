# NiftyEdge Pro — .gitignore

# Database (contains personal trade history — do not commit)
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Distribution / packaging
.eggs/
dist/
build/
*.egg-info/
*.egg
wheels/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment variables
.env
.env.local

# Generated secret key — never commit
.secret_key
